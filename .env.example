# Supabase — local values from `bunx supabase start`; hosted values from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ETL and local scripts only. Never on Vercel, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Hosted Postgres connection string (Project Settings → Database, password
# percent-encoded). Only `bun run db:pull-prod` reads it, to copy production
# into the local stack. Never on Vercel.
PROD_DB_URL=
# The Owner: whoever deploys the app and owns its infrastructure. `bun run
# db:seed-members` promotes this address to role='owner' — that is how a fresh
# deploy bootstraps itself. Afterwards the members row is the source of truth
# and further people are added by SQL (or a UI, later).
OWNER_EMAIL=you@company.com
# Comma-separated extra allowlist entries, seeded as project admins. Optional.
MEMBER_EMAILS=
# The local password `bun run db:dev-password` sets, and the one the e2e suite
# signs in with. Local only — it is never read on a deployed instance.
E2E_PASSWORD=admin123
