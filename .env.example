# Supabase — local values from `bunx supabase start`; hosted values from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ETL only. Never on Vercel, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated allowlist for `bun run db:seed-members`
MEMBER_EMAILS=you@company.com
# Local development only
NEXT_PUBLIC_ALLOW_PASSWORD_LOGIN=1
E2E_MEMBER_EMAIL=e2e@example.com
E2E_MEMBER_PASSWORD=e2e-password-local-only
