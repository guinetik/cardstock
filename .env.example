# Supabase — local values from `bunx supabase start`; hosted values from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ETL and local dev sign-in only. Never on Vercel, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The Owner: whoever deploys the app and owns its infrastructure. `bun run
# db:seed-members` promotes this address to role='owner' — that is how a fresh
# deploy bootstraps itself. Afterwards the members row is the source of truth
# and further people are added by SQL (or a UI, later).
OWNER_EMAIL=you@company.com
# Comma-separated extra allowlist entries, seeded as admins. Optional.
MEMBER_EMAILS=
# Local development only: sign in with an email and no password. Ignored unless
# NODE_ENV is not production *and* the Supabase URL points at this machine.
NEXT_PUBLIC_DEV_LOGIN=1
E2E_MEMBER_EMAIL=e2e@example.com
