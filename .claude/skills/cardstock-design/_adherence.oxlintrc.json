{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/board/**",
              "components/filing/**",
              "components/forms/**",
              "components/icon/**",
              "components/marks/**",
              "components/stock/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Binder'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|href|count|wide|tools|links|stacked|className|children|key|ref|className|style|children)$/]",
        "message": "<Binder> doesn't accept that prop. Declared props: name, href, count, wide, tools, links, stacked, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardCardTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|hue|key|ref|className|style|children)$/]",
        "message": "<BoardCardTag> doesn't accept that prop. Declared props: name, hue."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarSlip'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|board|shape|tint|tilt|lift|className|key|ref|className|style|children)$/]",
        "message": "<CalendarSlip> doesn't accept that prop. Declared props: id, title, board, shape, tint, tilt, lift, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalendarSlip'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:stub|full)$/]",
        "message": "<CalendarSlip> shape must be one of 'stub' | 'full'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColorPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|className|key|ref|className|style|children)$/]",
        "message": "<ColorPicker> doesn't accept that prop. Declared props: value, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='EpicLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|compact|className|key|ref|className|style|children)$/]",
        "message": "<EpicLabel> doesn't accept that prop. Declared props: name, compact, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='EpicTome'] > JSXAttribute > JSXIdentifier[name!=/^(?:outlook|shape|over|className|children|key|ref|className|style|children)$/]",
        "message": "<EpicTome> doesn't accept that prop. Declared props: outlook, shape, over, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='EpicTome'] > JSXAttribute[name.name='outlook'] > Literal[value!=/^(?:planning|on-track|attention|at-risk)$/]",
        "message": "<EpicTome> outlook must be one of 'planning' | 'on-track' | 'attention' | 'at-risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EpicTome'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:tile|slip)$/]",
        "message": "<EpicTome> shape must be one of 'tile' | 'slip'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|className|children|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: as, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Folder'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|href|count|section|empty|aside|as|className|children|key|ref|className|style|children)$/]",
        "message": "<Folder> doesn't accept that prop. Declared props: name, href, count, section, empty, aside, as, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LaneHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|kind|count|sla|tools|className|key|ref|className|style|children)$/]",
        "message": "<LaneHead> doesn't accept that prop. Declared props: name, kind, count, sla, tools, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='LaneHead'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:inbox|work|waiting|built|done|archive)$/]",
        "message": "<LaneHead> kind must be one of 'inbox' | 'work' | 'waiting' | 'built' | 'done' | 'archive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LaneMapCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:signal|tint|glyph|key|ref|className|style|children)$/]",
        "message": "<LaneMapCell> doesn't accept that prop. Declared props: signal, tint, glyph."
      },
      {
        "selector": "JSXOpeningElement[name.name='LaneMapCell'] > JSXAttribute[name.name='signal'] > Literal[value!=/^(?:queued|moving|late|blocked|delivered)$/]",
        "message": "<LaneMapCell> signal must be one of 'queued' | 'moving' | 'late' | 'blocked' | 'delivered'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Letterhead'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|blurb|links|aside|className|children|key|ref|className|style|children)$/]",
        "message": "<Letterhead> doesn't accept that prop. Declared props: eyebrow, title, blurb, links, aside, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:hue|off|as|className|children|key|ref|className|style|children)$/]",
        "message": "<Mark> doesn't accept that prop. Declared props: hue, off, as, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|as|disabled|onClick|className|children|key|ref|className|style|children)$/]",
        "message": "<PaperButton> doesn't accept that prop. Declared props: variant, size, as, disabled, onClick, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ink|outline|ghost|danger)$/]",
        "message": "<PaperButton> variant must be one of 'ink' | 'outline' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<PaperButton> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|tint|pinned|signal|as|className|children|key|ref|className|style|children)$/]",
        "message": "<PaperCard> doesn't accept that prop. Declared props: variant, tint, pinned, signal, as, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:resting|flat|static|still|overlay)$/]",
        "message": "<PaperCard> variant must be one of 'resting' | 'flat' | 'static' | 'still' | 'overlay'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperCard'] > JSXAttribute[name.name='signal'] > Literal[value!=/^(?:forgotten|overdue)$/]",
        "message": "<PaperCard> signal must be one of 'forgotten' | 'overdue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperField'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|mono|type|value|placeholder|onChange|className|children|key|ref|className|style|children)$/]",
        "message": "<PaperField> doesn't accept that prop. Declared props: as, mono, type, value, placeholder, onChange, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperField'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|select|textarea)$/]",
        "message": "<PaperField> as must be one of 'input' | 'select' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperLane'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|tint|collapsed|over|pinned|width|className|children|key|ref|className|style|children)$/]",
        "message": "<PaperLane> doesn't accept that prop. Declared props: kind, tint, collapsed, over, pinned, width, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperLane'] > JSXAttribute[name.name='tint'] > Literal[value!=/^(?:rose|orange|amber|green|cyan|blue|indigo|violet|pink)$/]",
        "message": "<PaperLane> tint must be one of 'rose' | 'orange' | 'amber' | 'green' | 'cyan' | 'blue' | 'indigo' | 'violet' | 'pink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperLane'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:default|max|spine)$/]",
        "message": "<PaperLane> width must be one of 'default' | 'max' | 'spine'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:danger|as|href|onClick|className|children|key|ref|className|style|children)$/]",
        "message": "<PaperLink> doesn't accept that prop. Declared props: danger, as, href, onClick, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperTooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|meta|hint|className|children|key|ref|className|style|children)$/]",
        "message": "<PaperTooltip> doesn't accept that prop. Declared props: lead, meta, hint, className, children."
