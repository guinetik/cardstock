        "selector": "JSXOpeningElement[name.name='Stamp'] > JSXAttribute > JSXIdentifier[name!=/^(?:faint|className|children|key|ref|className|style|children)$/]",
        "message": "<Stamp> doesn't accept that prop. Declared props: faint, className, children."
