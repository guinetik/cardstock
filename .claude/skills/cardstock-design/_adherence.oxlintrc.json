        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:wip|blocked|info|success|attention|muted|danger|ink|faint)$/]",
        "message": "<Stat> tone must be one of 'wip' | 'blocked' | 'info' | 'success' | 'attention' | 'muted' | 'danger' | 'ink' | 'faint'."
