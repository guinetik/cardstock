        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|flat|as|className|children|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: tone, flat, as, className, children."
