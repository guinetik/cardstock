        "message": "<Sq> doesn't accept that prop. Declared props: pen, on, as, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sq'] > JSXAttribute[name.name='pen'] > Literal[value!=/^(?:red|amber|green|blue|violet)$/]",
        "message": "<Sq> pen must be one of 'red' | 'amber' | 'green' | 'blue' | 'violet'."
